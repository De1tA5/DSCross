}

TriggerTime: {
	Label: 自动触发魔影激怒时间 （秒）
	Tooltip: 长按本模组提供魔影激怒键，自动触发所需的时间
}

RemoveEnrageSound: {
	Label: 移除魔影激怒的音效
	Tooltip: 仅移除本模组提供的魔影激怒音效
}

ReAddRedDevil: {
	Label: 重新添加红恶魔
	Tooltip: ""
}

DemonFlamesBack: {
	Label: 攻击施加恶魔之炎
	Tooltip: ""
}

RemoveDsSetNerf: {
	Label: 移除魔影激怒的削弱
	Tooltip: 由1.5倍回调至未削弱的2.25倍
}

