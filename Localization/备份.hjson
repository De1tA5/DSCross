ModName: 跨模组魔影套强化

Configs: {
	DSConfig: {
		DisplayName: 服务器配置

		Headers: {
			Calamity: "[i:DemonShadeCrossMod/CalamityIcon]灾厄"
			Thorium: "[i:DemonShadeCrossMod/ThoriumIcon]瑟银"
			ClickerClass: "[i:DemonShadeCrossMod/ClickerIcon]点击者"
			SOTS: "[i:DemonShadeCrossMod/SOTSIcon]暗影奥秘"
		}

		TriggerTime: {
			Label: 自动触发魔影激怒时间 （秒）
			Tooltip: 长按本模组提供魔影激怒键，自动触发所需的时间
		}

		RemoveEnrageSound: {
			Label: 移除魔影激怒的音效
			Tooltip: 仅移除本模组提供的魔影激怒音效
		}

		ReAddRedDevil: {
			Label: 重新添加红恶魔
			Tooltip: ""
		}

		DemonFlamesBack: {
			Label: 攻击施加恶魔之炎
			Tooltip: ""
		}

		RemoveDsSetNerf: {
			Label: 移除魔影激怒的削弱
			Tooltip: 由1.5倍回调至未削弱的2.25倍
		}

		EnableStealthMeter: {
			Label: 启用额外潜伏条
			Tooltip: ""
		}

		StealthMeterMax: {
			Label: 额外最大潜伏值
			Tooltip: ""
		}

		ExtraRogueVelocity: {
			Label: 盗贼弹幕速度
			Tooltip: ""
		}

		ExtraStealthGenMoving: {
			Label: 移动时潜伏值恢复速度
			Tooltip: ""
		}

		ExtraStealthGenStandStill: {
			Label: 静止时潜伏值恢复速度
			Tooltip: ""
		}

		EnableHealerSet: {
			Label: 启用牧师套装奖励
			Tooltip: ""
		}

		HealBonus: {
			Label: 额外治疗量
			Tooltip: ""
		}

		EnableBardSet: {
			Label: 启用吟游诗人套装奖励
			Tooltip: ""
		}

		OverrideCalBardHealer: {
			Label: "[C/FF9900:覆盖《非官方灾厄吟游诗人和牧师》]"
			Tooltip: 取消《非官方灾厄吟游诗人和牧师》提供魔影套的牧师和吟游诗人强化
		}

		HealToolSpeed: {
			Label: 治疗法术使用速度
			Tooltip: ""
		}

		BardInspirationRegenBonus: {
			Label: 灵感值再生速度
			Tooltip: ""
		}

		BardResourceDropBonus: {
			Label: 灵感音符掉落提升
			Tooltip: ""
		}

		BardResourceBonus: {
			Label: 额外最大灵感值
			Tooltip: ""
		}

		BardBuffDurationBonus: {
			Label: 咒音增幅持续时间乘算加成
			Tooltip: 此为最高的独立乘算区间
		}

		ExtraBardBuffDuration: {
			Label: 额外咒音增幅持续时间 （秒）
			Tooltip: 此为加算区间
		}

		BardRangeBonus: {
			Label: 咒音增幅覆盖范围
			Tooltip: ""
		}

		ExtraLevelBonus: {
			Label: 额外咒音增幅等级
			Tooltip: 原版《瑟银》最高只有4级，要更高等级需要《诸神的黄昏》
		}

		EnableThrowerSet: {
			Label: 启用投手套装奖励
			Tooltip: ""
		}

		ThrowerTechPointsBonus: {
			Label: 投手技巧点加成
			Tooltip: ""
		}

		ThrowerExhaustionRegenBonus: {
			Label: 投手疲劳值再生加成
			Tooltip: ""
		}

		ThrowerTechRechargeBonus: {
			Label: 投手技巧点充能加成
			Tooltip: ""
		}

		EnableClickerSet: {
			Label: 启用点击者套装奖励
			Tooltip: ""
		}

		ClickerRadiusBonus: {
			Label: 点击范围加成
			Tooltip: ""
		}

		ClickerEffectBonus: {
			Label: 点击效果加成
			Tooltip: 降低触发点击效果所需次数
		}

		ClickerEffect: {
			Label: 额外点击效果
			Tooltip: 穿戴魔影套提供魔影焰击点击效果
		}

		EnableVoidSet: {
			Label: 启用虚空套装奖励
			Tooltip: ""
		}

		VoidMax2Bonus: {
			Label: 额外最大虚空值加成
			Tooltip: ""
		}

		VoidRegenBonus: {
			Label: 虚空值恢复速度加成
			Tooltip: ""
		}

		VoidGainBonus: {
			Label: 虚空值恢复量加成
			Tooltip: ""
		}
	}

	DSClientConfig: {
		DisplayName: 客户端配置

		Headers: {
			TooltipOrder: 套装文本
			VFX: 视觉效果
		}

		RogueOrder: {
			Label: 盗贼
			Tooltip: 数值越小，越靠前
		}

		HealerOrder: {
			Label: 牧师
			Tooltip: 数值越小，越靠前
		}

		BardOrder: {
			Label: 乐师
			Tooltip: 数值越小，越靠前
		}

		ThrowerOrder: {
			Label: 投手
			Tooltip: 数值越小，越靠前
		}

		ClickerOrder: {
			Label: 点击者
			Tooltip: 数值越小，越靠前
		}

		VoidOrder: {
			Label: 虚空
			Tooltip: 数值越小，越靠前
		}

		DrawDataTest: {
			Label: 绘制调试
			Tooltip: 开发者使用调试功能
		}

		ShadowOutline: {
			Label: 绘制残影轮廓光
			Tooltip: 给残影也进行绘制轮廓光
		}

		DemonshadeOutline: {
			Label: 魔影套轮廓光
			Tooltip: 启用该选项后，以下配置参数才有作用
		}

		AllArmorOutline: {
			Label: 实验性：全部盔甲轮廓光绘制
			Tooltip:
				'''
				支持原版和其他模组盔甲的轮廓光绘制
				但由于部分盔甲带有额外材质贴图，无法保证全部有轮廓包围
				'''
		}

		OutlineColor: {
			Label: 轮廓光颜色
			Tooltip: ""
		}

		OutlineCoreWidth: {
			Label: 轮廓光宽度
			Tooltip: ""
		}

		OutlineHaloWidth: {
			Label: 轮廓光光晕宽度
			Tooltip: ""
		}

		OutlineHaloStrength: {
			Label: 轮廓光光晕强度
			Tooltip: ""
		}

		OutlineIntensity: {
			Label: 轮廓光总体强度
			Tooltip: ""
		}

		RogueDisplay: {
			// Label: Rogue Display
			// Tooltip: ""
		}

		HealerDisplay: {
			// Label: Healer Display
			// Tooltip: ""
		}

		BardDisplay: {
			// Label: Bard Display
			// Tooltip: ""
		}

		ThrowerDisplay: {
			// Label: Thrower Display
			// Tooltip: ""
		}

		ClickerDisplay: {
			// Label: Clicker Display
			// Tooltip: ""
		}

		VoidDisplay: {
			// Label: Void Display
			// Tooltip: ""
		}
	}
}

Keybinds.DemonShadeEnrage.DisplayName: 魔影激怒

ClickEffect: {
	DemonShadeClickerEffect: {
		Name: 魔影焰击
		Description: 降下恐怖魔焰焚毁你的敌人！
	}
}

Buffs: {
	DemonFlames: {
		DisplayName: 恶魔之炎
		Description: 来自异界的恐怖焚烧已然归来
		ItemTooltipPlayer: 火系 - 1250 DPS
		ItemTooltipEnemy:
			'''
			火系 - 1250 DPS
			额外增加15%对敌怪造成的伤害
			'''
	}
}

ExtraSetBonus: {
	RedDevilSetBonus: 重新召唤一只红恶魔为你而战
	DemonFlamesSetBonus: 击中敌怪施加其[cbuff:DemonShadeCrossMod/DemonFlames]减益
	Rogue:
		'''
		[C/A74F01:盗贼]
		增加{0}点最大潜伏值
		提升{1}%移动时潜伏值恢复速度
		提升{2}%静止时潜伏值恢复速度
		提升{3}%盗贼投掷弹幕速度
		'''
	Thrower:
		'''
		[C/FC9C41:投手]
		增加{0}点技巧值
		增加{1}点最大疲劳值
		提升{2}%疲劳值恢复速度
		提升{3}%技巧值充能速度
		'''
	Bard:
		'''
		[C/95F456:吟游诗人]
		增加{0}点额外最大灵感值
		提升{1}秒咒音增幅持续时间
		增加{2}%咒音增幅持续时间
		增加{3}%咒音增幅覆盖范围
		提升{4}%灵感值再生速度
		增加{5}%灵感音符掉落掉落概率
		咒音增幅额外提升{6}级
		'''
	Healer:
		'''
		[C/FFF850:牧师]
		治疗法术会额外治疗{0}点生命值
		提升{1}%治疗法术施法速度
		'''
	Clicker:
		'''
		[C/D2F8FB:点击者]
		增加{0}%基础点击范围
		减少{1}%点击效果所需次数
		'''
	Void:
		'''
		[C/6F00D8:虚空]
		增加{0}点最大虚空值
		提升{1}%虚空值恢复速度
		增加{2}虚空恢复量
		'''
}

Projectiles: {
